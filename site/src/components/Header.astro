---
import { getCollection } from 'astro:content';
import { perfil } from '../data/perfil';

const notas = await getCollection('notas', ({ data }) => !data.rascunho);

const itens = [
  { href: '/experiencia/', label: 'Experiência' },
  { href: '/projetos/', label: 'Projetos' },
  ...(notas.length > 0 ? [{ href: '/notas/', label: 'Notas' }] : []),
  { href: '/sobre-este-site/', label: 'Sobre este site' },
];

const atual = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">{perfil.nome}</a>
    <nav aria-label="Principal">
      <ul>
        {
          itens.map((item) => (
            <li>
              <a href={item.href} aria-current={atual.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
