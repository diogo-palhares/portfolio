---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const notas = (await getCollection('notas', ({ data }) => !data.rascunho)).sort(
  (a, b) => b.data.data.valueOf() - a.data.data.valueOf(),
);

const formatar = (d: Date) =>
  d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<Base title="Notas" description="Notas técnicas sobre infraestrutura, cloud e automação.">
  <header class="page-head">
    <h1>Notas</h1>
  </header>
  {notas.length === 0 && <p class="muted">Nenhuma nota publicada ainda.</p>}
  <ul class="post-list">
    {
      notas.map((nota) => (
        <li>
          <time datetime={nota.data.data.toISOString()} class="muted">
            {formatar(nota.data.data)}
          </time>
          <a href={`/notas/${nota.id}/`}>{nota.data.titulo}</a>
          <p>{nota.data.descricao}</p>
        </li>
      ))
    }
  </ul>
</Base>
