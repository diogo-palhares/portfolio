---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/profile';

const featured = (await getCollection('projects', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Base>
  <section class="hero">
    {profile.availability && <p class="badge">{profile.availability}</p>}
    <h1>{profile.name}</h1>
    <p class="role">{profile.title}</p>
    <p class="muted">{profile.location}</p>
    <p class="lead">{profile.summary}</p>
    <div class="actions">
      <a class="button primary" href={profile.cv} download>Download resume (PDF)</a>
      <a class="button" href={profile.links.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
      <a class="button" href={profile.links.github} rel="me noopener" target="_blank">GitHub</a>
      <a class="button" href={`mailto:${profile.links.email}`}>Email</a>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section>
        <div class="section-head">
          <h2>Featured projects</h2>
          <a href="/projects/">See all →</a>
        </div>
        <div class="grid">
          {featured.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    )
  }

  <section class="callout">
    <h2>How this site works</h2>
    <p>
      [FILL: 1-2 sentences inviting the reader to see the site's infrastructure, e.g. "This site is served by S3 +
      CloudFront, provisioned with Terraform and shipped by GitHub Actions over OIDC."]
    </p>
    <a href="/about-this-site/">See the architecture →</a>
  </section>
</Base>
