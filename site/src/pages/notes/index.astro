---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const format = (d: Date) =>
  d.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<Base title="Notes" description="Technical notes on infrastructure, cloud and automation.">
  <header class="page-head">
    <h1>Notes</h1>
  </header>
  {notes.length === 0 && <p class="muted">No notes published yet.</p>}
  <ul class="post-list">
    {
      notes.map((note) => (
        <li>
          <time datetime={note.data.date.toISOString()} class="muted">
            {format(note.data.date)}
          </time>
          <a href={`/notes/${note.id}/`}>{note.data.title}</a>
          <p>{note.data.description}</p>
        </li>
      ))
    }
  </ul>
</Base>
