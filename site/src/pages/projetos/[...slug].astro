---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projetos = await getCollection('projetos', ({ data }) => !data.rascunho);
  return projetos.map((projeto) => ({ params: { slug: projeto.id }, props: { projeto } }));
}

interface Props {
  projeto: CollectionEntry<'projetos'>;
}

const { projeto } = Astro.props;
const { titulo, resumo, stack, repositorio } = projeto.data;
const { Content } = await render(projeto);
---

<Base title={titulo} description={resumo}>
  <article class="prose">
    <p><a href="/projetos/">← Projetos</a></p>
    <h1>{titulo}</h1>
    <p class="lead">{resumo}</p>
    <ul class="tags" aria-label="Tecnologias">
      {stack.map((t) => <li>{t}</li>)}
    </ul>
    {
      repositorio && (
        <p>
          <a href={repositorio} rel="noopener" target="_blank">
            Ver repositório →
          </a>
        </p>
      )
    }
    <Content />
  </article>
</Base>
