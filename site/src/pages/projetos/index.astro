---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projetos = (await getCollection('projetos', ({ data }) => !data.rascunho)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);
---

<Base title="Projetos" description="Estudos de caso de projetos de infraestrutura, automação e DevOps.">
  <header class="page-head">
    <h1>Projetos</h1>
  </header>
  <p class="lead">
    [PREENCHER: 1 frase introduzindo os projetos, ex.: "Estudos de caso com contexto, decisões e resultados."]
  </p>
  <div class="grid">
    {projetos.map((projeto) => <ProjectCard projeto={projeto} />)}
  </div>
</Base>
