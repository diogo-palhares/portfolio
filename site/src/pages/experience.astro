---
import Base from '../layouts/Base.astro';
import { profile, experiences, skills, education, certifications } from '../data/profile';
---

<Base title="Experience" description={`Professional experience of ${profile.name}.`}>
  <header class="page-head">
    <h1>Experience</h1>
    <a class="button primary" href={profile.cv} download>Download resume (PDF)</a>
  </header>

  <section>
    <ol class="timeline">
      {
        experiences.map((exp) => (
          <li>
            <div class="timeline-head">
              <h2>
                {exp.role} <span class="muted">· {exp.company}</span>
              </h2>
              <p class="muted">
                {exp.period} · {exp.location}
              </p>
            </div>
            <p>{exp.description}</p>
            <ul>
              {exp.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
            <ul class="tags" aria-label="Technologies">
              {exp.stack.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  <section>
    <h2>Skills</h2>
    <div class="grid">
      {
        skills.map((g) => (
          <div class="card">
            <h3>{g.group}</h3>
            <ul class="tags">
              {g.items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Education</h2>
    <ul class="plain">
      {
        education.map((e) => (
          <li>
            <strong>{e.degree}</strong> · {e.institution} <span class="muted">({e.period})</span>
          </li>
        ))
      }
    </ul>
  </section>

  {
    certifications.length > 0 && (
      <section>
        <h2>Certifications</h2>
        <ul class="plain">
          {certifications.map((c) => (
            <li>
              {c.url ? (
                <a href={c.url} rel="noopener" target="_blank">
                  {c.name}
                </a>
              ) : (
                c.name
              )}{' '}
              <span class="muted">
                · {c.issuer} · {c.year}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
